# Supabase — copy to .env.local and fill in (Project → Settings → API).
# Both are SAFE for the browser (the publishable/anon key is meant to be public);
# they get inlined into the static build. Secrets (service-role key, license private
# key) live ONLY in the Edge Function's secrets, never here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
